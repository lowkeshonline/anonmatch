# Copy to .env (repo root) for docker compose. Never commit .env.
# docker compose reads .env automatically for ${VAR} substitution.

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Feeds BOTH services, so the web bundle and the token audience always match.
GOOGLE_CLIENT_ID=

# Browser-reachable URL of the API (host-visible, NOT the compose service name).
# Baked into the web bundle at build time, so changing it needs a rebuild.
VITE_SERVER_URL=http://localhost:4000

# Origins allowed to call the API. Must include the web origin.
CORS_ORIGINS=http://localhost:8080

# Optional overrides.
SERVER_PORT=4000
WEB_PORT=8080
ALLOWED_DOMAINS=*
SESSION_TTL_HOURS=24
