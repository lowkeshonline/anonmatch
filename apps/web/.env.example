# Copy to .env and fill in. Never commit .env.

# Must match GOOGLE_CLIENT_ID in apps/server/.env.
VITE_GOOGLE_CLIENT_ID=

# Leave blank when the API is served from the same origin as the app (Vite
# proxies /api and /socket.io in dev). Set it to the server's public URL when
# they are on different hosts.
VITE_SERVER_URL=