# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Comma-separated origin allowlist. No wildcards, no credentials mode.
CORS_ORIGINS=http://localhost:5173

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# This must match the ID in the web app's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Comma-separated allowlist. `*` allows any verified Google account.
# A bare entry matches the email domain exactly. An entry containing @ matches
# that one address. Example: ALLOWED_DOMAINS=marwadiuniversity.ac.in,example.com
ALLOWED_DOMAINS=*

# How long a session token stays valid.
SESSION_TTL_HOURS=24